# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key       # server-side only — never expose to client

# ── Solana ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet                    # mainnet | devnet  (anything ≠ "devnet" is treated as mainnet)
NEXT_PUBLIC_TREASURY_WALLET=11111111111111111111111111111111   # wallet that receives USDC credit purchases

# USDC mint
#   Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#   Devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ── AI providers ────────────────────────────────────────────────────────────
GEMINI_API_KEY=                                       # https://aistudio.google.com/app/apikey
FAL_KEY=                                              # https://fal.ai/dashboard/keys  (GPT Image 2 — text-to-image + edit)
MESHY_API_KEY=                                        # https://www.meshy.ai/          (text-to-3D + rigging — optional)

# ── Meteora DBC (token launches) ────────────────────────────────────────────
# Run `pnpm deploy:dbc-config` once to deploy a platform config, then paste the
# address here. Until this is filled, the "Launch token" CTA is disabled in the
# UI (see /api/tokens/config).
DBC_CONFIG_ADDRESS=
# Informational — printed by the deploy script alongside DBC_CONFIG_ADDRESS for
# your records. Not currently read by the app; kept here so a future in-app
# fee-claim flow has a single home for the address.
DBC_FEE_CLAIMER_ADDRESS=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin scripts (one-shot, run from repo root) ────────────────────────────
# Used by scripts/deploy-dbc-config.ts. Not loaded automatically — export them
# in your shell before running `pnpm deploy:dbc-config`, or wire dotenv into
# the script.
#   ADMIN_KEYPAIR_PATH=~/.config/solana/id.json
#   RPC_URL=https://api.devnet.solana.com
